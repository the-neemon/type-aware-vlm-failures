# Activation caches and model weights never enter the repo.
# Caches live on /scratch; see configs/activations.yaml for the path.
*.npz
*.npy
*.pt
*.pth
*.safetensors
*.bin
cache/
checkpoints/
hf_home/

# Data. ChartQA and generated synthetic figures are reproducible from
# scripts, so only manifests are tracked.
data/
!data/manifests/
*.png
*.jpg
*.jpeg
!paper/figures/*.png

# Results: small metrics and figures are tracked, bulk arrays are not.
results/**/*.npz
results/**/*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# SLURM
slurm-*.out
logs/

# Editors and OS
.DS_Store
.vscode/
.idea/

# LaTeX build files (the .tex sources and the built .pdf are tracked)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.out
paper/**/*.nav
paper/**/*.snm
paper/**/*.toc
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
